[Unit]
Description=Ively SmartEye Edge Agent
After=network-online.target mediamtx.service
Wants=network-online.target mediamtx.service

[Service]
WorkingDirectory=/opt/ively/edge
Environment=PYTHONPATH=/opt/ively/edge
Environment=IVELY_RTSP_STREAM_PROFILE=main
# Legacy fallback only; IVELY_RTSP_STREAM_PROFILE above controls main/sub selection now.
# Environment=IVELY_SUBSTREAM_ONLY=1
Environment=IVELY_RTSP_PROBE_URLS=1
ExecStart=/opt/ively/edge/installer/run-ively-agent.sh
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
